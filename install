#!/usr/bin/env bash
# Bootstrap HippoBridge's virtualenv (.python) and install dependencies, and
# optionally set up a system service (systemd or OpenRC).
#
# Usage:
#   ./install                    # venv + dependencies only (safe to re-run)
#   ./install systemd            # + install hippobridge.service, dedicated user
#   ./install openrc             # + install hippobridge.openrc, dedicated user
#   ./install alpine             # alias for openrc
#
#   PYTHON=python3.11 ./install  # pick a specific interpreter to build the venv from
#
# The systemd/openrc modes require root (they create a system user, chown the
# checkout to it, and write into /etc). They write UNINSTALL.md (gitignored)
# with the exact commands to reverse whatever this run did.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
INSTALL_DIR="$(pwd -P)"

VENV_DIR=".python"
PYTHON="${PYTHON:-python3}"
SERVICE_USER="hippobridge"
MODE="${1:-}"

case "$MODE" in
    ""|systemd|openrc|alpine) ;;
    *)
        echo "Usage: $0 [systemd|openrc|alpine]" >&2
        exit 2
        ;;
esac
[[ "$MODE" == "alpine" ]] && MODE="openrc"

write_uninstall() {
    {
        echo "# Uninstalling HippoBridge"
        echo
        echo "Generated by \`./install $MODE\` on $(date -Iseconds) for the checkout at \`$INSTALL_DIR\`."
        echo
        if [[ "$MODE" == "systemd" ]]; then
            cat <<EOF
## Stop and disable the service

\`\`\`bash
sudo systemctl disable --now hippobridge
sudo rm /etc/systemd/system/hippobridge.service
sudo systemctl daemon-reload
\`\`\`

## Remove the system user (only if not used elsewhere)

\`\`\`bash
sudo userdel $SERVICE_USER
\`\`\`

EOF
        elif [[ "$MODE" == "openrc" ]]; then
            cat <<EOF
## Stop and remove the service

\`\`\`bash
sudo rc-service hippobridge stop
sudo rc-update del hippobridge default
sudo rm /etc/init.d/hippobridge
sudo rm -f /etc/conf.d/hippobridge
\`\`\`

## Remove the system user (only if not used elsewhere)

\`\`\`bash
sudo deluser $SERVICE_USER
\`\`\`

EOF
        fi
        cat <<EOF
## Remove the virtualenv

\`\`\`bash
rm -rf "$INSTALL_DIR/$VENV_DIR"
\`\`\`

## Remove the checkout entirely

Careful — this also deletes \`local.cfg\`, \`worklist.cfg\`, logs, and any on-disk cache.

\`\`\`bash
rm -rf "$INSTALL_DIR"
\`\`\`
EOF
    } > "$INSTALL_DIR/UNINSTALL.md"
    echo "Wrote $INSTALL_DIR/UNINSTALL.md"
}

require_root() {
    if [[ $EUID -ne 0 ]]; then
        echo "error: './install $MODE' needs root (creates a system user, chowns the checkout, writes to /etc) — re-run with sudo" >&2
        exit 1
    fi
}

# Restrict credential-bearing config files to the owner, if present.
fix_config_perms() {
    for f in local.cfg worklist.cfg hippobridge.env; do
        [[ -f "$f" ]] && chmod 600 "$f"
    done
}

install_systemd() {
    require_root
    command -v systemctl >/dev/null || { echo "error: systemctl not found" >&2; exit 1; }

    if ! id "$SERVICE_USER" &>/dev/null; then
        echo "Creating system user $SERVICE_USER..."
        useradd --system --home-dir "$INSTALL_DIR" --shell /usr/sbin/nologin "$SERVICE_USER"
    else
        echo "System user $SERVICE_USER already exists, reusing it"
    fi

    mkdir -p "$INSTALL_DIR/log"
    echo "Fixing ownership of $INSTALL_DIR..."
    chown -R "$SERVICE_USER:$SERVICE_USER" "$INSTALL_DIR"
    fix_config_perms

    echo "Installing hippobridge.service (WorkingDirectory -> $INSTALL_DIR)..."
    sed "s#/opt/hippobridge#$INSTALL_DIR#g" hippobridge.service > /etc/systemd/system/hippobridge.service
    chmod 644 /etc/systemd/system/hippobridge.service
    systemctl daemon-reload

    write_uninstall
    echo "Done. Enable and start with: sudo systemctl enable --now hippobridge"
}

install_openrc() {
    require_root
    command -v rc-update >/dev/null || { echo "error: rc-update (OpenRC) not found" >&2; exit 1; }

    if ! id "$SERVICE_USER" &>/dev/null; then
        echo "Creating system user $SERVICE_USER..."
        adduser -S -D -H -h "$INSTALL_DIR" -s /sbin/nologin "$SERVICE_USER"
    else
        echo "System user $SERVICE_USER already exists, reusing it"
    fi

    mkdir -p "$INSTALL_DIR/log"
    echo "Fixing ownership of $INSTALL_DIR..."
    chown -R "$SERVICE_USER:$SERVICE_USER" "$INSTALL_DIR"
    fix_config_perms

    echo "Installing hippobridge.openrc as /etc/init.d/hippobridge..."
    install -m 755 hippobridge.openrc /etc/init.d/hippobridge

    if [[ "$INSTALL_DIR" != "/opt/hippobridge" ]]; then
        if [[ -e /etc/conf.d/hippobridge ]]; then
            echo "warning: /etc/conf.d/hippobridge already exists — add hippobridge_home=\"$INSTALL_DIR\" to it manually" >&2
        else
            printf 'hippobridge_home="%s"\n' "$INSTALL_DIR" > /etc/conf.d/hippobridge
        fi
    fi
    rc-update add hippobridge default

    write_uninstall
    echo "Done. Start with: sudo rc-service hippobridge start"
}

if [[ ! -d "$VENV_DIR" ]]; then
    echo "Creating virtualenv at $VENV_DIR (using $PYTHON)..."
    "$PYTHON" -m venv "$VENV_DIR"
else
    echo "Virtualenv already exists at $VENV_DIR, reusing it"
fi

echo "Installing dependencies from requirements.txt..."
"$VENV_DIR/bin/pip" install --upgrade pip
"$VENV_DIR/bin/pip" install -r requirements.txt

case "$MODE" in
    systemd) install_systemd ;;
    openrc)  install_openrc ;;
    *)       echo "Done. Start the server with ./hippobridge start" ;;
esac
