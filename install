#!/usr/bin/env bash
# Bootstrap HippoBridge's virtualenv (.python) and install dependencies, and
# optionally set up a system service (systemd or OpenRC).
#
# Usage:
#   ./install                        # venv + dependencies only, no root needed
#   ./install systemd [user]         # + install hippobridge.service under a system account
#   ./install openrc  [user]         # + install hippobridge.openrc under a system account (Alpine and others)
#   ./install service [user]         # + auto-detect systemd vs OpenRC and install that
#
#   [user] defaults to "hippobridge"; e.g. `./install systemd daemon` reuses
#   the existing "daemon" account instead of creating a new one.
#   PYTHON=python3.11 ./install      # pick a specific interpreter to build the venv from
#   ASSUME_YES=1 ./install systemd   # skip the confirmation prompt (for automation)
#
# The systemd/openrc modes require root (creating/reusing a system account,
# chowning the checkout, and writing into /etc all need it). They print a
# plan and ask for confirmation before touching anything, back up any /etc
# file they'd overwrite, and (re)write UNINSTALL.md (gitignored) with the
# exact commands to reverse this run — including removing the account only
# if this run actually created it. Neither mode auto-enables/starts the
# service; that's a separate, explicit step printed at the end.
#
# The venv itself is always (re)built by the service account via `su`, never
# by root directly — root only chowns the checkout to that account first, so
# a stale or tampered .python/ from an earlier unprivileged run never gets
# executed with root privileges.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
INSTALL_DIR="$(pwd -P)"

VENV_DIR=".python"
PYTHON="${PYTHON:-python3}"

build_venv() {
    if [[ ! -d "$VENV_DIR" ]]; then
        echo "Creating virtualenv at $VENV_DIR (using $PYTHON)..."
        "$PYTHON" -m venv "$VENV_DIR"
    else
        echo "Virtualenv already exists at $VENV_DIR, reusing it"
    fi
    echo "Installing dependencies from requirements.txt..."
    "$VENV_DIR/bin/pip" install --upgrade pip
    "$VENV_DIR/bin/pip" install -r requirements.txt
}

# Internal: re-invoked via `su` by install_systemd/install_openrc so the venv
# is built by (and owned by) the service account, not by root.
if [[ "${1:-}" == "--venv-only" ]]; then
    build_venv
    exit 0
fi

MODE="${1:-}"
case "$MODE" in
    ""|systemd|openrc) ;;
    service)
        if command -v systemctl >/dev/null; then
            MODE=systemd
        elif command -v rc-update >/dev/null; then
            MODE=openrc
        else
            echo "error: couldn't detect systemd or OpenRC on this system — pass 'systemd' or 'openrc' explicitly" >&2
            exit 1
        fi
        echo "Detected init system: $MODE"
        ;;
    *)
        echo "Usage: $0 [systemd|openrc|service] [service-user]" >&2
        exit 2
        ;;
esac

if [[ -z "$MODE" ]]; then
    build_venv
    echo "Done. Start the server with ./hippobridge start"
    exit 0
fi

SERVICE_USER="${2:-hippobridge}"
if [[ ! "$SERVICE_USER" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
    echo "error: '$SERVICE_USER' doesn't look like a valid unix username" >&2
    exit 1
fi
case "$SERVICE_USER" in
    daemon|nobody|www-data|bin|sys|root)
        echo "warning: '$SERVICE_USER' is a shared system account — a dedicated account isolates HippoBridge from whatever else runs as it" >&2
        ;;
esac

backup_if_exists() {
    if [[ -e "$1" ]]; then
        local bak
        bak="$1.bak.$(date +%Y%m%dT%H%M%S)"
        cp -a "$1" "$bak"
        echo "Backed up existing $1 -> $bak"
    fi
}

# Only set once install_systemd/install_openrc determine whether the account
# was created by this run (1) or already existed (0) — write_uninstall uses
# it to decide whether removal instructions are safe to print at all.
CREATED_USER=0
USERDEL_CMD=""

write_uninstall() {
    {
        echo "# Uninstalling HippoBridge"
        echo
        echo "Generated by \`./install $MODE $SERVICE_USER\` on $(date -Iseconds) for the checkout at \`$INSTALL_DIR\`."
        echo
        if [[ "$MODE" == "systemd" ]]; then
            cat <<EOF
## Stop and remove the service

\`\`\`bash
sudo systemctl disable --now hippobridge
sudo rm /etc/systemd/system/hippobridge.service
sudo systemctl daemon-reload
\`\`\`

EOF
        else
            cat <<EOF
## Stop and remove the service

\`\`\`bash
sudo rc-service hippobridge stop
sudo rc-update del hippobridge default
sudo rm /etc/init.d/hippobridge
sudo rm -f /etc/conf.d/hippobridge
\`\`\`

EOF
        fi
        if [[ "$CREATED_USER" == "1" ]]; then
            cat <<EOF
## Remove the system user this run created

\`\`\`bash
sudo $USERDEL_CMD $SERVICE_USER
\`\`\`

EOF
        else
            echo "This run reused the pre-existing '$SERVICE_USER' account — leaving it alone."
            echo
        fi
        cat <<EOF
## Remove the virtualenv

\`\`\`bash
rm -rf "$INSTALL_DIR/$VENV_DIR"
\`\`\`

## Remove the checkout entirely

Careful — this also deletes \`hippobridge.cfg\`, \`llm.cfg\`, \`regions.cfg\`, \`worklist.cfg\`, logs, and any on-disk cache.

\`\`\`bash
rm -rf "$INSTALL_DIR"
\`\`\`
EOF
    } > "$INSTALL_DIR/UNINSTALL.md"
    echo "Wrote $INSTALL_DIR/UNINSTALL.md"
}

# Restrict credential-bearing config files to the owner, if present.
fix_config_perms() {
    for f in hippobridge.cfg llm.cfg worklist.cfg hippobridge.env; do
        if [[ -f "$f" ]]; then
            chmod 600 "$f"
        fi
    done
}

# Build/refresh the venv as the service account (not root) — see header note.
run_venv_as_service_user() {
    su -s /bin/sh -c "PYTHON='$PYTHON' '$INSTALL_DIR/install' --venv-only" "$SERVICE_USER"
}

# --- Resolve the service account and print the plan up front ---------------

if id "$SERVICE_USER" &>/dev/null; then
    USER_STATUS="reusing existing account ($(id "$SERVICE_USER"))"
else
    USER_STATUS="will be created"
fi
CURRENT_OWNER="$(stat -c '%U' "$INSTALL_DIR" 2>/dev/null || echo unknown)"

echo "Plan for './install $MODE $SERVICE_USER':"
echo "  - service account '$SERVICE_USER': $USER_STATUS"
echo "  - $INSTALL_DIR (currently owned by $CURRENT_OWNER) will be chown -R'd to $SERVICE_USER:$SERVICE_USER — this affects git operations there too"
echo "  - $VENV_DIR/ will be (re)built as $SERVICE_USER, not root"
echo "  - hippobridge.cfg/llm.cfg/worklist.cfg/hippobridge.env (if present) will be chmod 600"
if [[ "$MODE" == "systemd" ]]; then
    echo "  - /etc/systemd/system/hippobridge.service will be written (any existing file backed up first)"
else
    echo "  - /etc/init.d/hippobridge will be written (any existing file backed up first)"
    echo "  - /etc/conf.d/hippobridge will be written if the install dir or user differ from the shipped defaults"
fi
echo "  - the service is NOT enabled or started automatically"
echo "  - $INSTALL_DIR/UNINSTALL.md will be (re)written"
echo

if [[ "${ASSUME_YES:-}" != "1" ]]; then
    read -r -p "Proceed? [y/N] " reply
    case "$reply" in
        y|Y|yes|YES) ;;
        *) echo "Aborted."; exit 1 ;;
    esac
fi

if [[ $EUID -ne 0 ]]; then
    echo "error: './install $MODE' needs root (creates/reuses a system account, chowns the checkout, writes to /etc) — re-run with sudo" >&2
    exit 1
fi

install_systemd() {
    command -v systemctl >/dev/null || { echo "error: systemctl not found" >&2; exit 1; }

    if id "$SERVICE_USER" &>/dev/null; then
        echo "System user $SERVICE_USER already exists, reusing it"
    else
        echo "Creating system user $SERVICE_USER..."
        useradd --system --home-dir "$INSTALL_DIR" --shell /usr/sbin/nologin "$SERVICE_USER"
        CREATED_USER=1
    fi
    USERDEL_CMD="userdel"

    mkdir -p "$INSTALL_DIR/log"
    echo "Fixing ownership of $INSTALL_DIR..."
    chown -R "$SERVICE_USER:$SERVICE_USER" "$INSTALL_DIR"

    run_venv_as_service_user
    fix_config_perms

    echo "Installing hippobridge.service (WorkingDirectory -> $INSTALL_DIR, User/Group -> $SERVICE_USER)..."
    backup_if_exists /etc/systemd/system/hippobridge.service
    sed -e "s#/opt/hippobridge#$INSTALL_DIR#g" \
        -e "s/^User=hippobridge$/User=$SERVICE_USER/" \
        -e "s/^Group=hippobridge$/Group=$SERVICE_USER/" \
        hippobridge.service > /etc/systemd/system/hippobridge.service
    chmod 644 /etc/systemd/system/hippobridge.service
    systemctl daemon-reload

    write_uninstall
    echo "Done. Next steps:"
    echo "  sudo systemctl enable --now hippobridge   # register at boot and start now"
    echo "  sudo systemctl status hippobridge         # verify it's running"
    echo "  journalctl -u hippobridge -f              # follow logs"
}

install_openrc() {
    command -v rc-update >/dev/null || { echo "error: rc-update (OpenRC) not found" >&2; exit 1; }

    if id "$SERVICE_USER" &>/dev/null; then
        echo "System user $SERVICE_USER already exists, reusing it"
    else
        echo "Creating system user $SERVICE_USER..."
        adduser -S -D -H -h "$INSTALL_DIR" -s /sbin/nologin "$SERVICE_USER"
        CREATED_USER=1
    fi
    USERDEL_CMD="deluser"

    mkdir -p "$INSTALL_DIR/log"
    echo "Fixing ownership of $INSTALL_DIR..."
    chown -R "$SERVICE_USER:$SERVICE_USER" "$INSTALL_DIR"

    run_venv_as_service_user
    fix_config_perms

    echo "Installing hippobridge.openrc as /etc/init.d/hippobridge..."
    backup_if_exists /etc/init.d/hippobridge
    install -m 755 hippobridge.openrc /etc/init.d/hippobridge

    if [[ "$INSTALL_DIR" != "/opt/hippobridge" || "$SERVICE_USER" != "hippobridge" ]]; then
        backup_if_exists /etc/conf.d/hippobridge
        {
            if [[ "$INSTALL_DIR" != "/opt/hippobridge" ]]; then
                printf 'hippobridge_home="%s"\n' "$INSTALL_DIR"
            fi
            if [[ "$SERVICE_USER" != "hippobridge" ]]; then
                printf 'hippobridge_user="%s"\n' "$SERVICE_USER"
                printf 'hippobridge_group="%s"\n' "$SERVICE_USER"
            fi
        } > /etc/conf.d/hippobridge
    fi

    write_uninstall
    echo "Done. Next steps:"
    echo "  sudo rc-update add hippobridge default   # register to start at boot"
    echo "  sudo rc-service hippobridge start        # start now"
    echo "  sudo rc-service hippobridge status       # verify it's running"
}

case "$MODE" in
    systemd) install_systemd ;;
    openrc)  install_openrc ;;
esac
