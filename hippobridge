#!/usr/bin/env bash
# Control script for the HippoBridge server: start/stop/restart/status.
#
# start/restart do NOT fork or background hippobridge.py themselves — the
# process stays in the foreground, same as Type=simple in hippobridge.service
# and supervise-daemon in hippobridge.openrc. Background it yourself if you
# want that (tmux/screen, `nohup ./hippobridge start &`, a supervisor, ...).
#
# Usage:
#   ./hippobridge start [extra args]     # foreground; refuses if already running
#   ./hippobridge stop
#   ./hippobridge restart [extra args]   # stop, then start (foreground)
#   ./hippobridge status
#
#   PIDFILE=/run/hippobridge.pid ./hippobridge status
#   ./hippobridge start --port 8080      # extra args pass through to hippobridge.py
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

PIDFILE="${PIDFILE:-hippobridge.pid}"
STOP_TIMEOUT="${STOP_TIMEOUT:-15}"

# Sets RUNNING_PID on a running process, STALE_PID on a dead one referenced
# by the pidfile. Returns 0 if running, 1 if stopped (stale or absent).
check_pid() {
    RUNNING_PID=""
    STALE_PID=""
    if [[ -f "$PIDFILE" ]]; then
        local pid
        pid="$(cat "$PIDFILE")"
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            RUNNING_PID="$pid"
            return 0
        else
            STALE_PID="$pid"
        fi
    fi
    return 1
}

do_status() {
    if check_pid; then
        echo "HippoBridge is running (pid $RUNNING_PID)"
        return 0
    elif [[ -n "$STALE_PID" ]]; then
        echo "HippoBridge is not running (stale pidfile, pid $STALE_PID)"
    else
        echo "HippoBridge is not running"
    fi
    return 1
}

do_stop() {
    if check_pid; then
        echo "Stopping HippoBridge (pid $RUNNING_PID)..."
        kill -TERM "$RUNNING_PID"
        local waited=0
        while kill -0 "$RUNNING_PID" 2>/dev/null; do
            if (( waited >= STOP_TIMEOUT )); then
                echo "warning: pid $RUNNING_PID did not exit after ${STOP_TIMEOUT}s, sending SIGKILL" >&2
                kill -KILL "$RUNNING_PID" 2>/dev/null || true
                break
            fi
            sleep 1
            waited=$((waited + 1))
        done
        rm -f "$PIDFILE"
    elif [[ -n "$STALE_PID" ]]; then
        echo "Stale pidfile (pid $STALE_PID not running), removing"
        rm -f "$PIDFILE"
    else
        echo "HippoBridge is not running"
    fi
}

do_start() {
    if check_pid; then
        echo "error: HippoBridge is already running (pid $RUNNING_PID)" >&2
        exit 1
    elif [[ -n "$STALE_PID" ]]; then
        echo "Stale pidfile (pid $STALE_PID not running), removing"
        rm -f "$PIDFILE"
    fi
    echo "Starting HippoBridge..."
    exec python3 hippobridge.py --pidfile "$PIDFILE" "$@"
}

cmd="${1:-}"
[[ $# -gt 0 ]] && shift

case "$cmd" in
    start)
        do_start "$@"
        ;;
    stop)
        do_stop
        ;;
    restart)
        do_stop
        do_start "$@"
        ;;
    status)
        do_status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status} [extra args for start/restart]" >&2
        exit 2
        ;;
esac
