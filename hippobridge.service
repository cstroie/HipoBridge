[Unit]
Description=HippoBridge scraping proxy server
Documentation=file:/opt/hippobridge/docs/ARCHITECTURE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as a dedicated, unprivileged system account rather than a personal
# user. One-time setup:
#   useradd --system --home-dir /opt/hippobridge --shell /usr/sbin/nologin hippobridge
#   git clone https://github.com/cstroie/HipoBridge.git /opt/hippobridge   # or rsync/symlink an existing checkout there
#   chown -R hippobridge:hippobridge /opt/hippobridge
#   sudo -u hippobridge /opt/hippobridge/install   # builds the .python venv
User=hippobridge
Group=hippobridge
WorkingDirectory=/opt/hippobridge

# The server itself needs no credentials (@require_auth forwards each
# request's own Basic Auth to Hipocrate). Only uncomment EnvironmentFile if
# you want the worklist SCP's HYP_USER/HYP_PASS fallback instead of setting
# [worklist] username/password directly in worklist.cfg. If you do use it,
# put credentials in that file (chmod 600, owned by hippobridge:hippobridge,
# NOT in git) — never inline here. The leading "-" makes a missing file
# non-fatal.
#EnvironmentFile=-/opt/hippobridge/hippobridge.env

# RuntimeDirectory creates /run/hippobridge (mode 0755, owned by the User=/
# Group= above) for the duration of the service, so the pidfile lives with
# other pidfiles under /run instead of inside the checkout.
RuntimeDirectory=hippobridge
ExecStart=/opt/hippobridge/.python/bin/python3 /opt/hippobridge/hippobridge.py --pidfile /run/hippobridge/hippobridge.pid
# SIGTERM triggers hippobridge.py's own graceful-shutdown handler
# (runner.cleanup()) — no need for KillSignal overrides. Give in-flight
# requests a bit of time before systemd escalates to SIGKILL.
TimeoutStopSec=20
Restart=on-failure
RestartSec=5

# systemd captures stdout/stderr itself — no need for hippobridge.out.
# Application logs still go to hippobridge.log via --log-file / local.cfg.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hippobridge

# Hardening. ReadWritePaths covers the checkout (for hippobridge.log,
# worklist.cfg/local.cfg edits); RuntimeDirectory above handles the pidfile
# and PrivateTmp isolates the on-disk cache under /tmp from other services.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hippobridge
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
